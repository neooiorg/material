# Neon Postgres (serverless) — connection string
# Lấy từ Neon dashboard: https://console.neon.tech (dùng chuỗi "Pooled connection")
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"

# Better Auth — sinh secret ngẫu nhiên: `openssl rand -hex 32`
BETTER_AUTH_SECRET="thay-bang-chuoi-ngau-nhien-32-byte"

# 2 biến URL dưới đây CHỈ cần cho môi trường dev (localhost).
# Khi deploy Vercel: KHÔNG cần set (tự nhận domain qua VERCEL_URL). Nếu muốn cố
# định thì đặt bằng domain thật, vd https://ten-app.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
# Khi web và API dùng hai hostname, liệt kê cả hai host (không kèm protocol).
# Ví dụ production: material.example.com,api.material.example.com
BETTER_AUTH_ALLOWED_HOSTS=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Express API (server/). CORS_ORIGINS là danh sách origin phân tách bằng dấu phẩy.
PORT="4000"
CORS_ORIGINS="http://localhost:8081"
APP_SCHEME="materialapp"
BOOTSTRAP_ADMIN_EMAILS="nttantts@gmail.com"

# Resend email notifications (backend only; không đưa vào EXPO_PUBLIC_).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Material App <onboarding@resend.dev>"
APP_URL="http://localhost:8081"

# Chỉ dành cho Expo client — không đưa secrets vào biến EXPO_PUBLIC_.
# Thiết bị thật phải dùng LAN URL hoặc HTTPS URL có thể truy cập được, không dùng localhost.
EXPO_PUBLIC_API_URL="http://192.168.1.10:4000"
